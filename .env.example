# Save as .env beside compose.yaml. Restart/recreate the service after changes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate once: openssl rand -hex 32
SESSION_SECRET=

# OpenAI-compatible model listing and embedding endpoint; also exposes /rerank.
OPENAI_API_KEY=
ROUTER_BASE_URL=https://router.tumuer.me/v1
HEAD_CHECK_URL=https://router.tumuer.me/
# Supports 300 / 5m (at :00, :05, :10, ...), 3600 / 1h (on the hour).
CHECK_INTERVAL_SECONDS=3600

DATABASE_PATH=./data/status.sqlite
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=false
