# Save as .env beside compose.yaml. Restart/recreate the service after changes.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate once: openssl rand -hex 32
SESSION_SECRET=

# live = Globalping + Tencent Cloud function probes, mock = deterministic local data, direct = local probes only (tests)
MONITORING_MODE=live

# Model discovery (GET /v1/models) and optional direct probes. Never sent to Globalping.
OPENAI_API_KEY=
ROUTER_BASE_URL=https://emrank.tech/v1
HEAD_CHECK_URL=https://emrank.tech/

# Optional region override. Docker only mounts ./data, so put regions.json there.
# MONITOR_REGIONS_FILE=./data/regions.json

# 3D globe destination (illustrative; not IP geolocation).
GLOBE_TARGET_LABEL=硅谷 · 服务目标
GLOBE_TARGET_LAT=37.3382
GLOBE_TARGET_LNG=-121.8863
# Custom regions may provide numeric lat/lng in regions.json.

# Globalping network layer
GLOBALPING_TARGET_URL=https://emrank.tech
# Optional free token: https://dash.globalping.io/tokens
GLOBALPING_TOKEN=
GLOBALPING_INTERVAL_SECONDS=300
GLOBALPING_HEALTH_PATH=/health
GLOBALPING_MODELS_PATH=/v1/models

# Tencent Cloud function probes (one Function URL per region in data/regions.json).
# Shared secret sent as x-probe-token; must match PROBE_TOKEN in every function.
CLOUD_PROBE_TOKEN=
CLOUD_PROBE_INTERVAL_SECONDS=30
# Server -> function HTTP request timeout.
CLOUD_PROBE_TIMEOUT_MS=30000
# Upstream model request timeout passed to the function.
CLOUD_PROBE_PROBE_TIMEOUT_MS=15000
# Concurrent function invocations per region.
CLOUD_PROBE_CONCURRENCY=4

# Function URL CAM authentication (server-side only).
# Grant scf:InvokeFunctionUrl to this identity and enable CAM on each Function URL.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# Main account UIN, not APPID or sub-account UIN. Keep it as a string.
TENCENTCLOUD_UIN=
# Optional STS session token; leave empty for permanent credentials.
TENCENTCLOUD_TOKEN=

# Scheduler tick ceiling; actual tick = min(this, Globalping interval, Cloud Probe interval)
CHECK_INTERVAL_SECONDS=300
DECISION_TEST_MODEL=typesafe/jev-latest

DATABASE_PATH=./data/status.sqlite
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=false
