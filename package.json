{
	"name": "status-for-router-tumuer-me",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/web",
		"apps/server"
	],
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev:web": "bun run --cwd apps/web dev",
		"dev:web:mock": "bun run --cwd apps/web dev -- --mode mock",
		"dev:server": "bun --watch apps/server/src/index.ts",
		"start": "bun apps/server/src/index.ts",
		"build:web": "bun run --cwd apps/web build",
		"test": "bun test apps/server/test",
		"typecheck": "bun run --cwd apps/server typecheck && bun run --cwd apps/web typecheck",
		"db:backup": "bun apps/server/src/backup.ts"
	}
}
