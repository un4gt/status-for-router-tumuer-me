	"private": true,
	"workspaces": [
		"apps/web",
		"apps/worker"
	],
	"scripts": {
		"dev:web": "bun run --cwd apps/web dev",
		"dev:web:mock": "bun run --cwd apps/web dev -- --mode mock",
